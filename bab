async function loadMaterials(id,admin=false,classId=null){
const s=await getDocs(collection(db,'materials'));

const ms=s.docs.map(d=>({id:d.id,...d.data()}))
.filter(m=>!classId||!m.classId||m.classId===classId);

$(id).innerHTML=ms.length
?ms.map(m=>item(m.judul,`
<p class="muted">${esc(m.deskripsi||'')}</p>
${m.link?`<p><a href="${esc(m.link)}" target="_blank" rel="noopener noreferrer">Buka materi ↗</a></p>`:''}
`)).join('')
:'<div class="empty">Belum ada materi untuk saat ini.</div>';
}

