<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ayo Dalami Peluang! — ADALUANG</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--purple:#8056d9;--dark:#35256c;--muted:#8984a5}
body{min-height:100vh;font-family:Nunito,sans-serif;color:var(--dark);overflow-x:hidden;background:radial-gradient(ellipse at 3% 28%,#f0e4ff 0%,transparent 34%),radial-gradient(ellipse at 99% 78%,#fff0f8 0%,transparent 32%),#fcfaff}
button,input,textarea{font:inherit}
button{cursor:pointer}
.page{min-height:100vh;display:grid;grid-template-columns:1.04fr 1.12fr .91fr;align-items:center;gap:30px;padding:55px 7.8%}
.pill{display:inline-block;padding:10px 17px;border-radius:30px;background:#f0e7ff;color:#8a66cf;font-size:11px;font-weight:900;letter-spacing:2px;margin-bottom:32px}
h1{font-size:clamp(43px,3.8vw,62px);line-height:1.06;letter-spacing:-1.5px;font-weight:900;color:#35256c}
h1 span{display:block;color:#8056d9}
.description{color:#8984a5;font-size:16px;font-weight:700;line-height:1.9;margin-top:23px;max-width:410px}
.math{margin-top:61px;font-size:19px;font-style:italic;color:#9879d1}
.left-art{width:100%;max-width:390px;margin-top:12px;display:block}
.center{width:100%;max-width:460px;justify-self:center;background:#ffffffef;border:1px solid #f1ecf8;border-radius:29px;padding:28px 29px 40px;box-shadow:0 22px 65px #664c9917;text-align:center}
.center h2{font-size:28px;font-weight:900;line-height:1.4}
.sub{color:#8984a5;font-size:16px;font-weight:700;margin:2px 0 21px}
.rooms{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.room{border:1px solid transparent;border-radius:21px;min-width:0;padding:17px 13px 15px;text-align:left;color:#352d55;transition:.2s}
.room:hover{transform:translateY(-4px);box-shadow:0 10px 22px #60468b15}
.teacher{background:linear-gradient(145deg,#f8f2ff,#eee7ff);border-color:#eae0fb}
.student{background:linear-gradient(145deg,#eff8ff,#e0f1ff);border-color:#deedfb}
.avatar{width:67px;height:67px;border-radius:50%;margin:0 auto 10px;display:flex;align-items:center;justify-content:center;background:#e1d0ff;font-size:34px}
.student .avatar{background:#cce9ff}
.room h3{font-size:16px;font-weight:900;white-space:nowrap}
.room p{font-size:11px;line-height:1.5;color:#8984a5;min-height:34px;margin-top:4px}
.arrow{margin-top:7px;height:31px;width:31px;display:flex;align-items:center;justify-content:center;border-radius:50%;color:white;background:#b89be9;font-size:21px}
.student .arrow{background:#79b8e9}
.register{margin-top:28px;color:#8984a5;font-size:12px}
.register button{background:none;border:0;color:#8056d9;font-weight:900;margin-left:5px}
.right{text-align:center}
.quote{font-size:15px;font-style:italic;line-height:1.8;color:#8984a5;margin-bottom:48px}
.formula{font-size:19px;font-style:italic;color:#a087d6;text-align:left}
.right-art{width:100%;max-width:370px;margin:auto;display:block}
.modal{display:none;position:fixed;inset:0;z-index:10;background:#2b1d4988;backdrop-filter:blur(5px);justify-content:center;align-items:center;padding:20px}
.modal.show{display:flex}
.modal-card{width:100%;max-width:430px;background:white;border-radius:25px;padding:30px;max-height:92vh;overflow:auto}
.modal-card h2{font-size:26px;margin-bottom:6px}
.modal-card>p{font-size:14px;color:var(--muted);margin-bottom:22px}
.field{margin-bottom:15px}
.field label{display:block;font-size:13px;font-weight:800;margin-bottom:7px}
.field input,.field textarea{width:100%;padding:13px;border:1px solid #e6def4;border-radius:12px;outline:none}
.field input:focus,.field textarea:focus{border-color:var(--purple)}
.submit,.secondary,.danger,.small-btn{border:0;border-radius:12px;padding:11px 14px;font-weight:900}
.submit{width:100%;background:var(--purple);color:white}
.submit:disabled{opacity:.6;cursor:wait}
.secondary,.small-btn{background:#f0e7ff;color:#6e49bd}
.danger{background:#fff0f2;color:#b3425a}
.cancel{width:100%;background:none;border:0;padding:12px;color:var(--muted)}
.message{font-size:13px;color:#b3425a;margin-top:12px;line-height:1.5}
.ok{color:#23866b!important}
.hidden{display:none!important}
.app{display:none;min-height:100vh;padding:24px;background:#fcfaff}
.app.show{display:block}
.app-top,.content{max-width:1100px;margin:auto}
.app-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:22px}
.brand{font-size:24px;font-weight:900}
.brand span{color:var(--purple)}
.userline{font-size:13px;font-weight:800;margin-bottom:6px;text-align:right}
.panel{background:white;border:1px solid #f1ecf8;border-radius:24px;padding:24px;margin-bottom:18px;box-shadow:0 15px 45px #664c9910}
.panel h2{font-size:25px;margin-bottom:7px}
.muted{color:var(--muted);font-size:14px;line-height:1.6}
.stats,.items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:15px 0}
.stats{grid-template-columns:repeat(5,minmax(0,1fr))}
.stat,.item{padding:16px;border:1px solid #eee6fa;border-radius:16px;overflow-wrap:anywhere}
.stat{background:#f7f1ff}
.stat strong{display:block;font-size:24px}
.stat span{font-size:12px;color:var(--muted);font-weight:800}
.item h3{margin-bottom:8px}
.item p{margin:7px 0}
.actions,.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.tabs button{background:#f4effc;color:#6e49bd;border:0;border-radius:10px;padding:10px 16px;font-weight:900}
.tabs button.active{background:#8056d9;color:white}
.code{display:inline-block;font-weight:900;letter-spacing:2px;color:#6845ae;background:#f0e7ff;padding:8px 12px;border-radius:10px;margin:6px 0}
.tag{display:inline-block;font-size:11px;font-weight:900;border-radius:20px;padding:5px 9px;background:#f0e7ff;color:#6e49bd}
.pending{background:#fff3d7;color:#946b08}
.approved{background:#e2f8ee;color:#23866b}
.rejected{background:#fff0f2;color:#b3425a}
.inline{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:15px}
.inline .full{grid-column:1/-1}
.empty{padding:22px;border:1px dashed #d9c9f2;border-radius:16px;color:var(--muted);font-size:14px;text-align:center}
.student-menu{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0}
.student-menu button{flex:1;min-width:130px;padding:14px 18px;border:1px solid #e8def8;border-radius:14px;background:#f4effc;color:#6e49bd;font-weight:900;font-size:15px}
.student-menu button.active{background:#8056d9;color:white;border-color:#8056d9}
.student-content{margin-top:10px}

/* Kartu menu materi */
.materi-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:18px}
.materi-card{background:linear-gradient(145deg,#f8f2ff,#eee7ff);border:2px solid #eae0fb;border-radius:20px;padding:24px 20px;text-align:center;cursor:pointer;transition:transform .2s,box-shadow .2s;font-family:Nunito,sans-serif}
.materi-card:hover{transform:translateY(-5px);box-shadow:0 12px 28px #60468b22}
.materi-card .materi-icon{font-size:48px;display:block;margin-bottom:12px;line-height:1}
.materi-card h3{font-size:17px;font-weight:900;color:#35256c;margin:0 0 8px}
.materi-card p{font-size:12px;color:#8984a5;line-height:1.5;margin:0 0 14px;min-height:38px}
.materi-card .materi-btn{display:inline-block;padding:9px 20px;border-radius:10px;background:#8056d9;color:white;font-weight:900;font-size:13px}
.materi-frame-wrap{margin-top:16px;border-radius:18px;overflow:hidden;border:1px solid #f1ecf8;background:white;box-shadow:0 8px 24px #664c9910}
.materi-frame-wrap iframe{width:100%;height:calc(100vh - 240px);min-height:600px;border:0;display:block}
.materi-back{display:inline-flex;align-items:center;gap:8px;background:#f4effc;color:#6e49bd;border:0;border-radius:10px;padding:10px 18px;font-weight:900;font-size:14px;cursor:pointer;margin-bottom:18px;font-family:Nunito,sans-serif}
.materi-back:hover{background:#e8dcfb}

@media(max-width:1100px){.page{grid-template-columns:1fr 1.05fr;padding:45px 6%}.right{display:none}}
@media(max-width:650px){
.page{display:flex;flex-direction:column;gap:28px;padding:35px 20px}
.left{text-align:center;width:100%}
h1{font-size:45px}
.description{font-size:14px;margin:17px auto 0}
.pill{margin-bottom:23px}
.math,.left-art{display:none}
.center{padding:27px 17px 32px}
.center h2{font-size:25px}
.room{padding:15px 9px}
.room h3{font-size:14px}
.room p{font-size:10px}
.inline,.items,.stats{grid-template-columns:1fr}
.app{padding:14px}
.panel{padding:18px}
.app-top{align-items:flex-start}
.userline{max-width:180px}
.materi-frame-wrap iframe{height:70vh;min-height:500px}
}
</style>
</head>

