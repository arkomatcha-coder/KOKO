async function teacherDashboard(){
$('content').innerHTML=`
<section class="panel">
<h2>Ruang Guru</h2>
<p class="muted">Guru yang disetujui dapat membuat kelas dan membagikan kode kepada murid. Guru tidak menambah atau mengedit materi.</p>

<form id="classForm" class="inline">
<div class="field">
<label>Nama kelas</label>
<input id="cname" required maxlength="80" placeholder="Contoh: X-1 Peluang">
</div>

<div class="field">
<label>Keterangan (opsional)</label>
<input id="cdesc" maxlength="120" placeholder="Matematika">
</div>

<div class="full">
<button class="submit">+ Buat kelas</button>
<p id="cmsg" class="message"></p>
</div>
</form>
</section>

<section class="panel">
<h2>Kelas Saya</h2>
<p class="muted">Bagikan kode kelas di bawah kepada murid.</p>
<div id="myClasses" class="items"></div>
</section>`;

$('classForm').addEventListener('submit',createClass);
await loadClasses();
}

function genCode(){
return Math.random().toString(36).slice(2,8).toUpperCase();
}

async function createClass(e){
e.preventDefault();

try{
const all=await getDocs(collection(db,'classes'));
let kode=genCode();

while(all.docs.some(d=>d.data().kode===kode)){
kode=genCode();
}

await addDoc(collection(db,'classes'),{
nama:$('cname').value.trim(),
deskripsi:$('cdesc').value.trim(),
kode,
ownerUid:profile.uid,
ownerEmail:profile.email,
createdAt:serverTimestamp()
});

$('cmsg').textContent='Kelas berhasil dibuat. Kode: '+kode;
$('cmsg').classList.add('ok');
$('classForm').reset();

await loadClasses();

}catch(e){
$('cmsg').textContent=errText(e);
}
}

async function loadClasses(){
const s=await getDocs(query(
collection(db,'classes'),
where('ownerUid','==',profile.uid)
));

$('myClasses').innerHTML=s.size
?s.docs.map(d=>item(d.data().nama,`
<p class="muted">${esc(d.data().deskripsi||'')}</p>
<div class="code">${esc(d.data().kode)}</div>
<p class="muted">Bagikan kode ini kepada murid.</p>
<div class="actions">
<button type="button" class="small-btn" onclick="copyCode('${esc(d.data().kode)}')">Salin kode</button>
<button type="button" class="danger" onclick="teacherDeleteClass('${d.id}')">Hapus kelas</button>
</div>
`)).join('')
:'<div class="empty">Kamu belum membuat kelas.</div>';
}

window.copyCode=async c=>{
try{
await navigator.clipboard.writeText(c);
alert('Kode kelas disalin: '+c);
}catch{
prompt('Salin kode kelas:',c);
}
};

window.teacherDeleteClass=async id=>{
if(!confirm('Hapus kelas ini?'))return;

try{
await deleteDoc(doc(db,'classes',id));
await loadClasses();
}catch(e){
alert(errText(e));
}
};

