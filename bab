<script type="module">
import{initializeApp}from'https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js';
import{getAuth,createUserWithEmailAndPassword,signInWithEmailAndPassword,signOut,onAuthStateChanged}from'https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js';
import{getFirestore,collection,doc,getDoc,getDocs,addDoc,setDoc,updateDoc,deleteDoc,query,where,serverTimestamp}from'https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js';

const ADMIN_EMAIL='umumbgt5@gmail.com';

const firebaseConfig={
apiKey:'AIzaSyDuVGHdk05SzOdTGuXsqfKZZwF1dYsmQDU',
authDomain:'adaluang.firebaseapp.com',
projectId:'adaluang',
storageBucket:'adaluang.firebasestorage.app',
messagingSenderId:'970393246155',
appId:'1:970393246155:web:e2f6971c49d85624acbe4',
measurementId:'G-PNKBBCZLMN'
};

const appFirebase=initializeApp(firebaseConfig);
const auth=getAuth(appFirebase);
const db=getFirestore(appFirebase);
const $=id=>document.getElementById(id);

let mode='login';
let profile=null;
let student=null;

const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({
'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
}[c]));

function say(t,ok=false){
$('message').textContent=t;
$('message').classList.toggle('ok',ok);
}

function openModal(title,subtitle,button,fields){
$('modalTitle').textContent=title;
$('modalSubtitle').textContent=subtitle;
$('submit').textContent=button;
$('form').reset();
say('');

for(const [k,id] of Object.entries({
name:'nameBox',
email:'emailBox',
password:'passBox',
code:'codeBox'
})){
$(id).classList.toggle('hidden',!fields.includes(k));
$(k).required=fields.includes(k);
}

$('modal').classList.add('show');
}

window.closeModal=()=>$('modal').classList.remove('show');

window.openTeacher=()=>{
mode='login';
openModal('Masuk Ruang Guru','Admin masuk menggunakan email admin. Guru harus memiliki akun yang disetujui admin.','Masuk',['email','password']);
};

window.openRegister=()=>{
mode='register';
openModal('Daftar Akun Guru','Akun guru harus disetujui admin sebelum membuat kelas.','Daftar',['name','email','password']);
};

window.openStudent=()=>{
mode='student';
openModal('Masuk Ruang Murid','Masukkan nama dan kode kelas dari guru.','Mulai Belajar',['name','code']);
};

$('modal').addEventListener('click',e=>{
if(e.target===$('modal'))closeModal();
});

function errText(e){
const errors={
'auth/invalid-credential':'Email atau kata sandi salah.',
'auth/email-already-in-use':'Email sudah terdaftar.',
'auth/weak-password':'Kata sandi minimal 6 karakter.',
'auth/invalid-email':'Format email tidak valid.',
'permission-denied':'Akses ditolak. Periksa Firestore Rules.'
};
return errors[e.code]||e.message||'Terjadi kesalahan.';
}

async function getProfile(u){
const r=doc(db,'users',u.uid);
const s=await getDoc(r);

if(s.exists())return s.data();

if((u.email||'').toLowerCase()===ADMIN_EMAIL.toLowerCase()){
const p={
nama:'Admin ADALUANG',
email:u.email,
role:'admin',
status:'approved',
createdAt:serverTimestamp()
};
await setDoc(r,p);
return p;
}
return null;
}

$('form').addEventListener('submit',async e=>{
e.preventDefault();
$('submit').disabled=true;

try{
if(mode==='register'){
const nama=$('name').value.trim();
const email=$('email').value.trim().toLowerCase();
const password=$('password').value;

if(!nama)throw Error('Nama wajib diisi.');
if(email===ADMIN_EMAIL.toLowerCase())throw Error('Email admin tidak bisa digunakan untuk pendaftaran guru.');

const c=await createUserWithEmailAndPassword(auth,email,password);

await setDoc(doc(db,'users',c.user.uid),{
nama,email,role:'guru',status:'pending',createdAt:serverTimestamp()
});

await signOut(auth);
say('Pendaftaran berhasil. Tunggu persetujuan admin.',true);
return;
}

if(mode==='student'){
const nama=$('name').value.trim();
const kode=$('code').value.trim().toUpperCase();

if(!nama||!kode)throw Error('Nama dan kode kelas wajib diisi.');

const s=await getDocs(collection(db,'classes'));
const d=s.docs.find(x=>(x.data().kode||'').toUpperCase()===kode);

if(!d)throw Error('Kode kelas tidak ditemukan. Periksa kembali kode dari guru.');

student={nama,kode,id:d.id,data:d.data()};
closeModal();
renderStudent();
return;
}

await signInWithEmailAndPassword(
auth,
$('email').value.trim().toLowerCase(),
$('password').value
);

closeModal();

}catch(e){
say(errText(e));
}finally{
$('submit').disabled=false;
}
});

onAuthStateChanged(auth,async u=>{
if(!u){
profile=null;
return;
}

try{
let p=await getProfile(u);

if(!p){
await signOut(auth);
alert('Profil akun tidak ditemukan. Daftar akun guru terlebih dahulu.');
return;
}

if(u.email.toLowerCase()===ADMIN_EMAIL.toLowerCase()&&p.role!=='admin'){
await updateDoc(doc(db,'users',u.uid),{role:'admin',status:'approved'});
p.role='admin';
p.status='approved';
}

if(p.role==='guru'&&p.status!=='approved'){
await signOut(auth);
alert(p.status==='rejected'?'Akun guru ditolak admin.':'Akun guru masih menunggu persetujuan admin.');
return;
}

if(!['admin','guru'].includes(p.role)){
await signOut(auth);
alert('Peran akun tidak valid.');
return;
}

profile={...p,uid:u.uid,email:u.email};
student=null;
showDashboard();

}catch(e){
alert(errText(e));
await signOut(auth);
}
});

function showShell(label){
$('landing').style.display='none';
$('app').classList.add('show');
$('userLine').textContent=label;
}

function showDashboard(){
showShell((profile.nama||profile.email)+' · '+(profile.role==='admin'?'Admin':'Guru'));
if(profile.role==='admin')adminDashboard();
else teacherDashboard();
}

window.logout=async()=>{
if(auth.currentUser)await signOut(auth);
profile=null;
student=null;
$('app').classList.remove('show');
$('landing').style.display='block';
};

function item(title,body){
return `<article class="item"><h3>esc(title||'Kelas')</h3>{body}</article>`;
}

/* =========================
   DASHBOARD ADMIN
========================= */

async function adminDashboard(){
$('content').innerHTML=`
<section class="panel">
<h2>Dashboard Admin</h2>
<p class="muted">Kelola pendaftaran guru, pantau status akun, dan kelola kelas ADALUANG.</p>

<div id="adminStats" class="stats">
<div class="empty">Memuat statistik...</div>
</div>

<div class="tabs">
<button type="button" onclick="adminTab('guru')">Manajemen Guru</button>
<button type="button" onclick="adminTab('kelas')">Manajemen Kelas</button>
</div>

<div id="adminSection"></div>
</section>`;

try{
const us=await getDocs(collection(db,'users'));
const cs=await getDocs(collection(db,'classes'));

const teachers=us.docs.map(d=>d.data()).filter(x=>x.role==='guru');

const total=teachers.length;
const active=teachers.filter(x=>x.status==='approved').length;
const pending=teachers.filter(x=>x.status==='pending').length;
const rejected=teachers.filter(x=>x.status==='rejected').length;

$('adminStats').innerHTML=`
<div class="stat"><strong>${total}</strong><span>Total Guru</span></div>
<div class="stat"><strong>${active}</strong><span>Guru Aktif</span></div>
<div class="stat"><strong>${pending}</strong><span>Menunggu Persetujuan</span></div>
<div class="stat"><strong>${rejected}</strong><span>Guru Ditolak</span></div>
<div class="stat"><strong>${cs.size}</strong><span>Total Kelas</span></div>`;

await adminTab('guru');

}catch(e){
$('adminStats').innerHTML=`<div class="empty">Gagal memuat statistik: ${esc(errText(e))}</div>`;
$('adminSection').innerHTML=`<div class="empty">Periksa izin akses Firestore lalu muat ulang halaman.</div>`;
}
}

window.adminTab=async tab=>{
const el=$('adminSection');
el.innerHTML='<div class="empty">Memuat…</div>';

try{
if(tab==='guru'){
const s=await getDocs(collection(db,'users'));
const ts=s.docs.map(d=>({id:d.id,...d.data()})).filter(x=>x.role==='guru');

el.innerHTML=ts.length
?`<div class="items">${ts.map(t=>item(t.nama,`
<p class="muted">${esc(t.email)}</p>
<span class="tag esc(t.status)">{esc(t.status)}</span>
<div class="actions">
${t.status!=='approved'?`<button type="button" class="small-btn" onclick="setStatus('${t.id}','approved')">Terima</button>`:''}
${t.status!=='rejected'?`<button type="button" class="danger" onclick="setStatus('${t.id}','rejected')">Tolak</button>`:''}
</div>
`)).join('')}</div>`
:'<div class="empty">Belum ada akun guru.</div>';

}else{
const s=await getDocs(collection(db,'classes'));

el.innerHTML=s.size
?`<div class="items">${s.docs.map(d=>item(d.data().nama,`
<p class="muted">${esc(d.data().ownerEmail)}</p>
<div class="code">${esc(d.data().kode)}</div>
<div class="actions">
<button type="button" class="danger" onclick="deleteClass('${d.id}')">Hapus kelas</button>
</div>
`)).join('')}</div>`
:'<div class="empty">Belum ada kelas.</div>';
}

}catch(e){
el.innerHTML=`<div class="empty">${esc(errText(e))}</div>`;
}
};

window.setStatus=async(id,status)=>{
try{
await updateDoc(doc(db,'users',id),{status});
await adminTab('guru');
}catch(e){
alert(errText(e));
}
};

window.deleteClass=async id=>{
if(!confirm('Hapus kelas ini?'))return;

try{
await deleteDoc(doc(db,'classes',id));
await adminTab('kelas');
}catch(e){
alert(errText(e));
}
};

